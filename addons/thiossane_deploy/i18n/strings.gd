static func tr_ui(lang: String, key: String) -> String:
	var bag: Dictionary = STRINGS.get(lang, STRINGS["fr"])
	if bag.has(key): return str(bag[key])
	return str(STRINGS["fr"].get(key, key))

static func detect_lang(config_path: String, section: String) -> String:
	var cfg := ConfigFile.new()
	if cfg.load(config_path) == OK:
		var saved := str(cfg.get_value(section, "lang", ""))
		if saved in ["fr", "en", "zh"]: return saved
	var loc := "fr"
	if Engine.is_editor_hint():
		loc = str(EditorInterface.get_editor_settings().get_setting("interface/editor/editor_language"))
	if loc.begins_with("en"): return "en"
	if loc.begins_with("zh") or loc.begins_with("cn"): return "zh"
	return "fr"

static func next_lang(current: String) -> String:
	match current:
		"fr": return "en"
		"en": return "zh"
		_: return "fr"
